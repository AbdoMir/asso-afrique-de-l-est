# Variables d'environnement — Association Afrique de l'Est et ses amis
# Copier ce fichier en .env.local et remplir les valeurs

# ─── SUPABASE ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# ─── COORDONNÉES BANCAIRES (virement — affichage informatif uniquement) ────
NEXT_PUBLIC_BANK_HOLDER=Association Afrique de l'Est et ses amis
NEXT_PUBLIC_BANK_IBAN=FRXX XXXX XXXX XXXX XXXX XXXX XXX
NEXT_PUBLIC_BANK_BIC=XXXXXXXX

# ─── STRIPE ────────────────────────────────────────────────────────────────
# Clés API (Développeurs > Clés API). Utiliser les clés de test (sk_test_,
# pk_test_) tant que le compte n'est pas activé.
#
# À renseigner dans les TROIS environnements Vercel, Preview compris : sans
# elles, les déploiements de prévisualisation ne permettent pas de tester le
# parcours de don.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret de signature du webhook (Développeurs > Webhooks > votre endpoint).
# En local, `stripe listen` en affiche un différent à chaque lancement.
# Sans lui, le webhook refuse toute notification : c'est la seule preuve
# qu'elle vient bien de Stripe et non d'un tiers.
STRIPE_WEBHOOK_SECRET=whsec_...

# Tarifs récurrents des dons mensuels (Catalogue > Produits). Le montant vit
# chez Stripe et non dans le code : une valeur transmise par le navigateur
# pourrait être modifiée avant l'envoi.
STRIPE_PRICE_MONTHLY_5=price_...
STRIPE_PRICE_MONTHLY_10=price_...
STRIPE_PRICE_MONTHLY_20=price_...

# ─── RESEND ────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=contact@asso-aes.fr
RESEND_FROM_NAME=Association Afrique de l'Est et ses amis

# ─── MESURE D'AUDIENCE ─────────────────────────────────────────────────────
# Vercel Web Analytics, activé depuis le tableau de bord Vercel : aucune
# variable à définir. Sans cookie ni identifiant persistant, il ne requiert pas
# de bandeau de consentement — voir la politique de confidentialité, qui doit
# toujours décrire l'outil réellement en place.

# ─── PURGE RGPD ────────────────────────────────────────────────────────────
# Secret partagé avec le cron Vercel (vercel.json) qui exécute chaque nuit la
# suppression des données arrivées au terme de leur conservation. Sans cette
# variable, la route /api/cron/purge refuse toutes les requêtes.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# ─── APP ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ASSOCIATION_NAME=Association Afrique de l'Est et ses amis
NEXT_PUBLIC_ASSOCIATION_EMAIL=asso.afrique.est.et.ses.amis@outlook.fr
NEXT_PUBLIC_ASSOCIATION_PHONE=06 05 67 59 11
# SIREN, SIRET, code APE, adresse du siège et régime juridique ne sont plus des
# variables d'environnement : ils vivent dans lib/association.ts. Ce sont des
# données publiques (répertoire SIRENE), et les laisser ici les faisait
# apparaître en production sous forme de valeurs fictives.
